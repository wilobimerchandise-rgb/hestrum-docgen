// Credit notes (Playbook sections 7.2, 8.4; vector G10).
// Expected values are literals from the playbook or computed in JavaScript (including SHA-256 and the VAT arithmetic), never by the SQL under test.
import { PGlite } from '@electric-sql/pglite';
import fs from 'node:fs';
import crypto from 'node:crypto';
import assert from 'node:assert/strict';

const OWNER = '00000000-0000-0000-0000-0000000000a1';
const STAFF = '00000000-0000-0000-0000-0000000000a2';
const DEPUTY = '00000000-0000-0000-0000-0000000000a3';
const ACCT = '00000000-0000-0000-0000-0000000000a7';
const CASH = '00000000-0000-0000-0000-0000000000a8';
const OFFICER = '00000000-0000-0000-0000-0000000000a9';
const MAKER = '00000000-0000-0000-0000-0000000000aa';
const NOBODY = '00000000-0000-0000-0000-000000000099';
const db = new PGlite();
let passed = 0;

const nowSec = () => Math.floor(Date.now() / 1000);
const as = async (uid, role, fn, mfaAgeSec = 10) => {
  const claims = { aal: 'aal2', amr: [{ method: 'totp', timestamp: nowSec() - mfaAgeSec }] };
  await db.exec(`select set_config('app.uid', '${uid}', false)`);
  await db.exec(`select set_config('request.jwt.claims', '${JSON.stringify(claims)}', false)`);
  if (role) await db.exec(`set role ${role}`);
  try { return await fn(); } finally {
    if (role) await db.exec('reset role');
    await db.exec(`select set_config('app.uid', '', false)`);
    await db.exec(`select set_config('request.jwt.claims', '', false)`);
  }
};
const q = async (sql, params) => (await db.query(sql, params)).rows;
const t = async (name, fn) => { await fn(); passed++; console.log('ok  -', name); };
const who = (uid) => (sql, params, age) => as(uid, 'authenticated', () => q(sql, params), age);
const sup = (uid, sql, params, age) => as(uid, null, () => q(sql, params), age);
const owner = who(OWNER); const staff = who(STAFF); const deputy = who(DEPUTY); const acct = who(ACCT);
const cash = who(CASH); const officer = who(OFFICER); const maker = who(MAKER);
const setSub = (periodEnd) => db.exec(`delete from subscription; insert into subscription(plan, current_period_end) values ('annual', '${periodEnd}')`);
const sha = (s) => crypto.createHash('sha256').update(s, 'utf8').digest('hex');
const lagosToday = () => new Intl.DateTimeFormat('en-CA', { timeZone: 'Africa/Lagos' }).format(new Date());
const today = lagosToday();
const YEAR = Number(today.slice(0, 4));
const halfUp = (n, d) => (2n * n + d) / (2n * d);

await db.exec(`
  create schema auth;
  create table auth.users(id uuid primary key);
  create function auth.uid() returns uuid language sql stable as $$ select nullif(current_setting('app.uid', true), '')::uuid $$;
  create role anon nologin; create role authenticated nologin;
  grant usage on schema auth to anon, authenticated;
  grant execute on function auth.uid() to anon, authenticated;
  insert into auth.users(id) values ('${OWNER}'), ('${STAFF}'), ('${DEPUTY}'), ('${ACCT}'), ('${CASH}'), ('${OFFICER}'), ('${MAKER}');
`);
for (const f of ['0000_profiles.sql', '0001_subscription.sql', '0002_roles_audit.sql', '0003_money.sql', '0004_documents_issue.sql',
  '0005_drafts_customers.sql', '0006_payments_receipts.sql', '0007_credit_notes.sql']) {
  await db.exec(fs.readFileSync(new URL(`../migrations/${f}`, import.meta.url), 'utf8'));
}
await db.exec(`
  insert into commercial_config(trial_days, grace_days, reminder_days, price_notice_days) values (14, 7, '{30,7,1}', 30);
  insert into plan_prices(effective_from, annual_fee_kobo) values ('2000-01-01', 100000000);
  insert into profiles(user_id, full_name, role, role_id) values ('${OWNER}', 'Ngozi Eze', 'owner', (select id from roles where is_owner));
  insert into business_settings(business_name, address, registration_number, tin, vat_enabled, vat_rate_bp, bank_name, account_name, account_number)
    values ('Hestrum Projects & Services Limited', '12 Example Road, Port Harcourt, Rivers State', 'RC 0000000', '00000000-0001', true, 750,
            'Example Bank Plc', 'Hestrum Projects & Services Limited', '0000000000');
`);
await setSub('2099-01-01T00:00:00Z');
const roleId = async (n) => (await q('select id from roles where name = $1', [n]))[0].id;
await owner('select save_role($1, $2, $3::jsonb)', [await roleId('Cashier'), 'Cashier',
  JSON.stringify([{ capability: 'payments.record_evidence' }, { capability: 'payments.confirm', cap_kobo: 60000000 }])]);
const officerRole = (await owner('select save_role(null, $1, $2::jsonb) as id', ['Credit officer',
  JSON.stringify([{ capability: 'draft.view_all' }, { capability: 'creditnotes.issue', cap_kobo: 3000000 }])]))[0].id;
const makerRole = (await owner('select save_role(null, $1, $2::jsonb) as id', ['Maker with credit',
  JSON.stringify([{ capability: 'draft.create_own' }, { capability: 'customers.manage' }, { capability: 'vat.change_per_document' },
    { capability: 'creditnotes.issue', cap_kobo: 3000000 }])]))[0].id;
for (const [uid, name, role] of [[STAFF, 'Chinedu Eze', await roleId('Staff')], [DEPUTY, 'Ada Obi', await roleId('Deputy approver')],
  [ACCT, 'Tunde Ojo', await roleId('Accountant')], [CASH, 'Kemi Adebayo', await roleId('Cashier')],
  [OFFICER, 'Femi Lawal', officerRole], [MAKER, 'Ife Okon', makerRole]]) {
  await owner('select assign_role($1, $2, $3)', [uid, name, role]);
}

const cust = async (name) => (await owner('select create_customer($1, $2) as id', [name, '45 Sample Street, Port Harcourt']))[0].id;
const mkInvoice = async (customer, qtyMilli, unit, doc = {}, by = OWNER) => {
  const body = { doc_type: 'invoice', customer_id: customer, payment_terms_days: 14, vat_enabled: false,
    lines: [{ description: 'Item', qty_milli: qtyMilli, unit_kobo: unit }], ...doc };
  const id = (await who(by)('select save_draft($1, $2::jsonb) as r', [null, JSON.stringify(body)]))[0].r.id;
  await owner('select approve_and_issue($1)', [id]);
  return id;
};
const lines = (...rows) => JSON.stringify(rows.map(([description, qty_milli, unit_kobo]) => ({ description, qty_milli: String(qty_milli), unit_kobo: String(unit_kobo) })));
const one = (unit, qty = 1000) => lines(['Credit for returned goods', qty, unit]);
let keySeq = 0;
const credit = (fn, inv, ls, reason = 'Goods returned', key = `ck-${++keySeq}`, age) =>
  fn('select issue_credit_note($1, $2::uuid, $3::jsonb, $4) as r', [key, inv, ls, reason], age).then((r) => r[0].r);
const status = async (id) => (await owner('select invoice_payment_status($1) as r', [id]))[0].r;
const rec = async (uid, key, c, amount, ref) =>
  (await who(uid)('select record_payment($1, $2, $3, $4, $5::date, $6, $7) as id', [key, c, String(amount), 'transfer', today, ref, null]))[0].id;
const pay = async (c, inv, amount, ref) => {
  const id = await rec(ACCT, `pay-${ref}`, c, amount, ref);
  await owner('select confirm_payment($1::uuid, $2::jsonb, $3) as r', [id, JSON.stringify([{ invoice_id: inv, cash_kobo: String(amount), wht_kobo: '0' }]), 'Bank alert seen']);
  return id;
};
const counts = async () => (await q(`select (select count(*) from documents where doc_type = 'credit_note')::int as d,
  (select coalesce(sum(last_value), 0) from document_counters where doc_type = 'credit_note')::int as c,
  (select count(*) from credit_note_requests)::int as r, (select count(*) from audit_log)::int as au, (select count(*) from render_jobs)::int as j`))[0];
let notes = 0;     // credit notes issued in the current year so far: numbers must be gapless
const noteCounter = async (year = YEAR) => Number((await q("select last_value from document_counters where doc_type = 'credit_note' and year = $1", [year]))[0]?.last_value ?? 0);

const K = await cust('Adaeze Okafor Ventures');

await t('C1 G10: invoice 10,750,000 (base 10,000,000 + 7.5% VAT); credit on base 2,000,000 -> VAT 150,000, total 2,150,000, net 8,600,000; 9,000,000 base rejected; payments of 8,600,000 settle it', async () => {
  const inv = await mkInvoice(K, '1000', '10000000', { vat_enabled: true });
  assert.equal((await status(inv)).total, '10750000');
  const r = await credit(owner, inv, one(2000000), 'Damaged boards returned');
  notes++;
  assert.deepEqual([r.number, r.total, r.vat, r.net_invoice, r.balance_after, r.already_issued], [`CRN-${YEAR}-0001`, '2150000', '150000', '8600000', '8600000', false]);
  const s = await status(inv);
  assert.deepEqual([s.state, s.credited, s.balance, s.total], ['unpaid', '2150000', '8600000', '10750000']);

  const d = (await q('select doc_type, status, number, total_kobo, vat_kobo, base_kobo, subtotal_kobo, source_document_id, customer_id, snapshot, snapshot_hash, prev_hash from documents where id = $1', [r.credit_note_id]))[0];
  assert.deepEqual([d.doc_type, d.status, d.number, String(d.total_kobo), String(d.vat_kobo), String(d.base_kobo), String(d.subtotal_kobo), d.source_document_id, d.customer_id],
    ['credit_note', 'issued', `CRN-${YEAR}-0001`, '2150000', '150000', '2000000', '2000000', inv, K]);
  assert.equal(d.snapshot.document.invoice_number, (await q('select number from documents where id = $1', [inv]))[0].number);
  assert.equal(d.snapshot.document.reason, 'Damaged boards returned');
  assert.deepEqual(d.snapshot.vat, { enabled: true, rate_bp: 750, amount: '150000' });
  assert.deepEqual(d.snapshot.totals, { subtotal: '2000000', vat: '150000', total: '2150000' });
  assert.deepEqual(d.snapshot.lines, [{ sn: 1, description: 'Credit for returned goods', qty_milli: '1000', unit_kobo: '2000000', line_total: '2000000' }]);
  assert.deepEqual(d.snapshot.effect_on_invoice, { invoice_total: '10750000', earlier_credits: '0', this_credit: '2150000', net_invoice: '8600000', paid_to_date: '0', balance_due: '8600000' });
  assert.equal(d.snapshot.customer.name, 'Adaeze Okafor Ventures');
  assert.equal(d.snapshot.creator_name, 'Ngozi Eze');
  const text = (await q('select snapshot::text as s from documents where id = $1', [r.credit_note_id]))[0].s;
  assert.equal(d.snapshot_hash, sha(d.prev_hash + '|' + text));
  assert.equal((await q("select count(*)::int as n from render_jobs where document_id = $1 and reason = 'issue' and status = 'queued'", [r.credit_note_id]))[0].n, 1);
  assert.equal((await q("select count(*)::int as n from audit_log where action = 'ISSUE_CREDIT_NOTE' and subject = $1", [r.credit_note_id]))[0].n, 1);

  const baseline = await counts();
  await assert.rejects(() => credit(owner, inv, one(9000000)), /CREDIT_EXCEEDS_INVOICE/);          // base 9,000,000 -> total 9,675,000 > 8,600,000
  assert.deepEqual(await counts(), baseline);
  // The largest credit that still fits: remaining 8,600,000 = base 8,000,000 + VAT 600,000.
  await assert.rejects(() => credit(owner, inv, one(8000001)), /CREDIT_EXCEEDS_INVOICE/);

  await pay(K, inv, 8600000, 'NIP-G10-0001');
  const paid = await status(inv);
  assert.deepEqual([paid.state, paid.balance, paid.settled, paid.credited], ['paid', '0', '8600000', '2150000']);   // payments of 8,600,000 settle it
  await assert.rejects(() => credit(owner, inv, one(100)), /CREDIT_BELOW_PAYMENTS/);               // nothing left to credit once settled
  assert.equal(await noteCounter(), notes);
  assert.equal((await q('select verify_snapshot_chain() as ok'))[0].ok, true);
});

await t('C2 net invoice may not fall below confirmed payments; full credit gives state "credited"; earlier credits carried; void and payment rules follow', async () => {
  const inv = await mkInvoice(K, '1000', '1000000');                    // no VAT
  await pay(K, inv, 700000, 'NIP-C2-1');
  const baseline = await counts();
  await assert.rejects(() => credit(owner, inv, one(300001)), /CREDIT_BELOW_PAYMENTS/);             // would leave net 699,999 < 700,000 paid
  assert.deepEqual(await counts(), baseline);
  const a = await credit(owner, inv, one(100000)); notes++;
  const b = await credit(owner, inv, one(200000)); notes++;                                         // exactly to the payments floor
  assert.equal(b.balance_after, '0');
  const snapB = (await q('select snapshot from documents where id = $1', [b.credit_note_id]))[0].snapshot;
  assert.deepEqual(snapB.effect_on_invoice, { invoice_total: '1000000', earlier_credits: '100000', this_credit: '200000', net_invoice: '700000', paid_to_date: '700000', balance_due: '0' });
  assert.equal(a.number, `CRN-${YEAR}-${String(notes - 1).padStart(4, '0')}`);
  assert.equal(b.number, `CRN-${YEAR}-${String(notes).padStart(4, '0')}`);
  assert.equal((await status(inv)).state, 'paid');
  await assert.rejects(() => credit(owner, inv, one(1)), /CREDIT_BELOW_PAYMENTS/);

  // An unpaid invoice credited in full is "credited", and nothing more can be collected, adjusted or voided.
  const small = await mkInvoice(K, '1000', '5000');
  const full = await credit(owner, small, one(5000)); notes++;
  const s = await status(small);
  assert.deepEqual([s.state, s.balance, s.credited, s.settled], ['credited', '0', '5000', '0']);
  await assert.rejects(() => credit(owner, small, one(1)), /CREDIT_EXCEEDS_INVOICE/);
  const p = await rec(ACCT, 'c2-late', K, 1, 'NIP-C2-LATE');
  await assert.rejects(() => owner('select confirm_payment($1::uuid, $2::jsonb, $3)', [p, JSON.stringify([{ invoice_id: small, cash_kobo: '1', wht_kobo: '0' }]), 'x']), /ALLOCATION_EXCEEDS_BALANCE/);
  await db.exec('update business_settings set short_pay_cap_kobo = 10000');
  await assert.rejects(() => owner('select adjust_short_pay($1, $2)', [small, 'x']), /NOTHING_TO_ADJUST/);
  await db.exec('update business_settings set short_pay_cap_kobo = 0');
  await assert.rejects(() => owner('select void_document($1, $2)', [small, 'Wrong invoice']), /VOID_BLOCKED_CREDIT_NOTES/);
  await assert.rejects(() => owner('select void_document($1, $2)', [full.credit_note_id, 'Wrong']), /CREDIT_NOTE_VOID_UNSUPPORTED/);
  assert.equal((await q('select status from documents where id = $1', [small]))[0].status, 'issued');
  // Reversing a payment after a credit keeps the balance consistent: total - credits - settled.
  const inv2 = await mkInvoice(K, '1000', '1000000');
  const pid = await pay(K, inv2, 400000, 'NIP-C2-2');
  await credit(owner, inv2, one(500000)); notes++;
  assert.equal((await status(inv2)).balance, '100000');
  await owner('select reverse_payment($1, $2)', [pid, 'Chargeback']);
  assert.equal((await status(inv2)).balance, '500000');
  // A balance closed by a short-pay adjustment cannot be credited again (the adjustment already wrote it off).
  const adj = await mkInvoice(K, '1000', '1000000');
  await pay(K, adj, 995000, 'NIP-C2-ADJ');
  await db.exec('update business_settings set short_pay_cap_kobo = 10000');
  await owner('select adjust_short_pay($1, $2)', [adj, 'Bank charges']);
  await db.exec('update business_settings set short_pay_cap_kobo = 0');
  await assert.rejects(() => credit(owner, adj, one(1)), /CREDIT_BELOW_PAYMENTS/);
  assert.equal((await status(adj)).balance, '0');
  assert.equal(await noteCounter(), notes);
});

await t('C3 VAT uses the INVOICE snapshot rate, never today\'s; a non-VAT invoice credits without VAT; rounding once (G3 shape)', async () => {
  const withVat = await mkInvoice(K, '1000', '2000000', { vat_enabled: true });
  await db.exec('update business_settings set vat_rate_bp = 1000');                                  // rate changes after the invoice was issued
  const r = await credit(owner, withVat, one(1000000)); notes++;
  assert.deepEqual([r.vat, r.total], ['75000', '1075000']);                                           // 7.5%, not 10%
  await db.exec('update business_settings set vat_enabled = false');                                 // VAT switched off business-wide
  const r2 = await credit(owner, withVat, one(1000000)); notes++;
  assert.deepEqual([r2.vat, r2.total], ['75000', '1075000']);                                         // the invoice still had VAT
  await db.exec('update business_settings set vat_enabled = true, vat_rate_bp = 750');
  const noVat = await mkInvoice(K, '1000', '2000000');
  const r3 = await credit(owner, noVat, one(1000000)); notes++;
  assert.deepEqual([r3.vat, r3.total], ['0', '1000000']);
  const snap = (await q('select snapshot from documents where id = $1', [r3.credit_note_id]))[0].snapshot;
  assert.deepEqual(snap.vat, { enabled: false, rate_bp: null, amount: '0' });
  // VAT rounds once, half up: base 6, 7 and 20 kobo give 0, 1 and 2 (vector G3).
  const big = await mkInvoice(K, '1000', '1000000', { vat_enabled: true });
  const got = [];
  for (const unit of [6, 7, 20]) { got.push((await credit(owner, big, one(unit))).vat); notes++; }
  assert.deepEqual(got, ['0', '1', '2']);
  // Multi-line credit: line totals rounded once each (qty 2.5 x 1,000.01 = 250,003 kobo, vector G6).
  const multi = await credit(owner, big, lines(['Half boards', 2500, 100001], ['Delivery', 1000, 1000])); notes++;
  const m = (await q('select snapshot from documents where id = $1', [multi.credit_note_id]))[0].snapshot;
  assert.deepEqual(m.lines.map((x) => [x.sn, x.line_total]), [[1, '250003'], [2, '1000']]);
  assert.equal(m.totals.subtotal, '251003');
  assert.equal(m.totals.vat, String(halfUp(251003n * 750n, 10000n)));                                 // 18,825.225 -> 18,825
  assert.equal(await noteCounter(), notes);
});

await t('C4 validation: shape, money limits, reason, key, target document; every failure changes nothing', async () => {
  const inv = await mkInvoice(K, '1000', '5000000');
  const draft = (await owner('select save_draft(null, $1::jsonb) as r', [JSON.stringify({ doc_type: 'invoice', customer_id: K, payment_terms_days: 14, vat_enabled: false,
    lines: [{ description: 'D', qty_milli: '1000', unit_kobo: '100' }] })]))[0].r.id;
  const quote = (await owner('select save_draft(null, $1::jsonb) as r', [JSON.stringify({ doc_type: 'quotation', customer_id: K, valid_until: '2099-01-31', vat_enabled: false,
    lines: [{ description: 'Q', qty_milli: '1000', unit_kobo: '100' }] })]))[0].r.id;
  await owner('select approve_and_issue($1)', [quote]);
  const voided = await mkInvoice(K, '1000', '5000000');
  await owner('select void_document($1, $2)', [voided, 'Mistake']);
  const receipt = (await q("select id from documents where doc_type = 'receipt' limit 1"))[0].id;
  const ghost = '11111111-1111-1111-1111-111111111111';
  const baseline = await counts();
  const bad = [
    [inv, '[]', 'Reason', /LINES_COUNT/], [inv, '{}', 'Reason', /LINES_INVALID/], [inv, 'null', 'Reason', /LINES_INVALID/],
    [inv, '[1]', 'Reason', /LINES_INVALID/], [inv, lines(['  ', 1000, 100]), 'Reason', /DESCRIPTION_REQUIRED/],
    [inv, JSON.stringify([{ qty_milli: '1000', unit_kobo: '100' }]), 'Reason', /DESCRIPTION_REQUIRED/],
    [inv, lines(['x', 0, 100]), 'Reason', /QTY_RANGE/], [inv, lines(['x', 1000000001, 100]), 'Reason', /QTY_RANGE/],
    [inv, lines(['x', 1000, '-5']), 'Reason', /PRICE_RANGE/], [inv, lines(['x', 1000, '10.5']), 'Reason', /PRICE_RANGE/],
    [inv, lines(['x', 1000, 0]), 'Reason', /TOTAL_NOT_ABOVE_ZERO/],
    [inv, one(100), '   ', /REASON_REQUIRED/], [inv, one(100), null, /REASON_REQUIRED/],
    [draft, one(100), 'Reason', /INVOICE_NOT_FOUND/], [quote, one(100), 'Reason', /INVOICE_NOT_FOUND/], [receipt, one(100), 'Reason', /INVOICE_NOT_FOUND/],
    [ghost, one(100), 'Reason', /INVOICE_NOT_FOUND/], [null, one(100), 'Reason', /INVOICE_NOT_FOUND/], [voided, one(100), 'Reason', /INVOICE_VOID/],
  ];
  for (const [target, ls, reason, re] of bad) {
    await assert.rejects(() => credit(owner, target, ls, reason), re, String(re));
    assert.deepEqual(await counts(), baseline);                                                       // no number, row, request, audit or job
  }
  for (const key of ['   ', 'x'.repeat(101)]) await assert.rejects(() => credit(owner, inv, one(100), 'Reason', key), /IDEMPOTENCY_KEY_REQUIRED/);
  assert.deepEqual(await counts(), baseline);
  // A credit exactly the size of the invoice is allowed (here: 5,000,000, no VAT); one kobo more is not.
  await assert.rejects(() => credit(owner, inv, one(5000001)), /CREDIT_EXCEEDS_INVOICE/);
  await credit(owner, inv, one(5000000)); notes++;
  assert.equal(await noteCounter(), notes);
  // Large quantities and the document limit are enforced by the money engine.
  const big = await mkInvoice(K, '1000', '1000000000000');                                            // 10,000,000,000.00 naira, the limit
  await assert.rejects(() => credit(owner, big, one('1000000000001')), /PRICE_RANGE/);
  await credit(owner, big, one('1000000000000')); notes++;
  assert.equal((await status(big)).state, 'credited');
});

await t('C5 authority: capability, cap, four-eyes on the invoice, fresh MFA; Owner exempt from cap and four-eyes only; read-only mode refuses', async () => {
  const inv = await mkInvoice(K, '1000', '10000000');                                                 // created by the Owner
  const makerInv = await mkInvoice(K, '1000', '10000000', {}, MAKER);
  const baseline = await counts();
  for (const fn of [staff, acct, deputy, cash, who(NOBODY)]) await assert.rejects(() => credit(fn, inv, one(1000)), /CAPABILITY_DENIED/);
  await assert.rejects(() => credit(officer, inv, one(1000), 'Reason', 'k', 3600), /MFA_REQUIRED/);
  await assert.rejects(() => credit(owner, inv, one(1000), 'Reason', 'k', 3600), /MFA_REQUIRED/);    // MFA applies to the Owner too
  await assert.rejects(() => credit(officer, inv, one(3000001)), /OVER_CAP/);                         // cap 3,000,000
  await assert.rejects(() => credit(maker, makerInv, one(1000)), /FOUR_EYES/);                        // never against one's own invoice
  assert.deepEqual(await counts(), baseline);
  const ok = await credit(officer, inv, one(3000000)); notes++;                                       // exactly the cap
  assert.equal(ok.total, '3000000');
  assert.equal((await q('select created_by from documents where id = $1', [ok.credit_note_id]))[0].created_by, OFFICER);
  await credit(officer, makerInv, one(1000)); notes++;                                                // a different person may credit the maker's invoice
  await credit(owner, inv, one(4000000)); notes++;                                                    // the Owner has no cap
  await credit(owner, inv, one(100)); notes++;
  const ownerInv = await mkInvoice(K, '1000', '1000');
  await credit(owner, ownerInv, one(500)); notes++;                                                   // Owner credits an invoice they created
  await setSub(new Date(Date.now() - 864e5).toISOString());
  await assert.rejects(() => credit(owner, inv, one(100)), /ACCESS_/);
  await setSub('2099-01-01T00:00:00Z');
  assert.equal(await noteCounter(), notes);
});

await t('C6 idempotency: the same key returns the original credit note; a changed request with the same key is refused; keys are per user', async () => {
  const inv = await mkInvoice(K, '1000', '4000000');
  const first = await credit(owner, inv, one(1000000), 'Returned', 'idem-1'); notes++;
  const other = await mkInvoice(K, '1000', '4000000');
  const before = await counts();
  const again = await credit(owner, inv, one(1000000), 'Returned', 'idem-1');
  assert.deepEqual([again.credit_note_id, again.number, again.already_issued], [first.credit_note_id, first.number, true]);
  assert.deepEqual(await counts(), before);
  await assert.rejects(() => credit(owner, other, one(1000000), 'Returned', 'idem-1'), /IDEMPOTENCY_KEY_REUSED/);
  await assert.rejects(() => credit(owner, inv, one(1000000), 'A different reason', 'idem-1'), /IDEMPOTENCY_KEY_REUSED/);
  assert.deepEqual(await counts(), before);
  const mine = await credit(officer, other, one(1000), 'Returned', 'idem-1'); notes++;              // the same key text for another user
  assert.notEqual(mine.credit_note_id, first.credit_note_id);
  assert.equal((await status(inv)).credited, '1000000');                                             // credited once only
  assert.equal(await noteCounter(), notes);
});

await t('C7 numbering by Lagos year, own sequence, hash chain verified in JavaScript, tampering detected', async () => {
  const inv = await mkInvoice(K, '1000', '9000000');
  const at = async (iso, key) => (await sup(OWNER, 'select issue_credit_core($1, $2::uuid, $3::jsonb, $4, $5::timestamptz) as r', [key, inv, one(100000), 'Year test', iso]))[0].r;
  assert.equal(await noteCounter(2027), 0);
  const a = await at('2026-12-31T23:30:00Z', 'y1');                                                   // 00:30 on 1 Jan 2027 in Lagos
  assert.equal(a.number, 'CRN-2027-0001');
  assert.equal((await q('select issue_date::text as d, number_year from documents where id = $1', [a.credit_note_id]))[0].d, '2027-01-01');
  const b = await at('2027-12-31T22:59:59Z', 'y2');
  assert.equal(b.number, 'CRN-2027-0002');
  const c = await at('2027-12-31T23:00:00Z', 'y3');
  assert.equal(c.number, 'CRN-2028-0001');
  assert.equal(await noteCounter(), notes);                                                           // this year's counter untouched
  assert.equal((await q("select count(*)::int as n from document_counters where doc_type = 'invoice'"))[0].n >= 1, true);
  const rows = await q('select chain_seq, prev_hash, snapshot_hash, snapshot::text as s from documents where chain_seq is not null order by chain_seq');
  let prev = '0'.repeat(64);
  for (const r of rows) { assert.equal(r.prev_hash, prev); assert.equal(r.snapshot_hash, sha(prev + '|' + r.s)); prev = r.snapshot_hash; }
  assert.ok(rows.length > 40);
  assert.equal((await q('select verify_snapshot_chain() as ok'))[0].ok, true);
  await db.exec('alter table documents disable trigger documents_guard_row');
  await db.exec(`update documents set snapshot = jsonb_set(snapshot, '{totals,total}', '"1"') where id = '${a.credit_note_id}'`);
  await db.exec('alter table documents enable trigger documents_guard_row');
  assert.equal((await q('select verify_snapshot_chain() as ok'))[0].ok, false);
  await db.exec('alter table documents disable trigger documents_guard_row');
  await db.exec(`update documents set snapshot = jsonb_set(snapshot, '{totals,total}', '"100000"') where id = '${a.credit_note_id}'`);
  await db.exec('alter table documents enable trigger documents_guard_row');
  assert.equal((await q('select verify_snapshot_chain() as ok'))[0].ok, true);                       // restored exactly
  // An issued credit note is immutable.
  await assert.rejects(() => db.exec(`update documents set total_kobo = 1 where id = '${a.credit_note_id}'`), /DOCUMENT_IMMUTABLE/);
  await assert.rejects(() => db.exec(`delete from documents where id = '${a.credit_note_id}'`), /DOCUMENT_IMMUTABLE/);
  await assert.rejects(() => db.exec('update credit_note_requests set reason = $$x$$'), /INSERT_ONLY_TABLE/);
});

await t('C8 privileges: no direct writes, internal core not callable, request table closed', async () => {
  const id = '11111111-1111-1111-1111-111111111111';
  await assert.rejects(() => owner(`select issue_credit_core('k', '${id}', '[]', 'x', now())`), /permission denied/);
  await assert.rejects(() => as(OWNER, 'anon', () => q(`select issue_credit_note('k', '${id}', '[]', 'x')`)), /permission denied/);
  await assert.rejects(() => as(OWNER, 'anon', () => q(`select issue_credit_core('k', '${id}', '[]', 'x', now())`)), /permission denied/);
  await assert.rejects(() => as('', 'authenticated', () => q(`select issue_credit_note('k', '${id}', '[]', 'x')`)), /CAPABILITY_DENIED|NOT_AUTHENTICATED/);
  await assert.rejects(() => owner('select * from credit_note_requests'), /permission denied/);
  await assert.rejects(() => owner('insert into credit_note_requests(created_by, idempotency_key, invoice_id, reason, document_id) values (gen_random_uuid(), $$k$$, gen_random_uuid(), $$r$$, gen_random_uuid())'), /permission denied/);
  await assert.rejects(() => owner("insert into documents(doc_type, customer_id, created_by) values ('credit_note', gen_random_uuid(), gen_random_uuid())"), /permission denied/);
  // The draft API still refuses to create a credit note or a receipt.
  await assert.rejects(() => owner('select save_draft(null, $1::jsonb)', [JSON.stringify({ doc_type: 'credit_note', customer_id: K })]), /DOC_TYPE_INVALID/);
  // Visibility: Staff cannot read other people's credit notes; the Owner and a viewer role can.
  assert.equal((await staff("select count(*)::int as n from documents where doc_type = 'credit_note'"))[0].n, 0);
  assert.ok((await owner("select count(*)::int as n from documents where doc_type = 'credit_note'"))[0].n > 10);
  assert.ok((await officer("select count(*)::int as n from documents where doc_type = 'credit_note'"))[0].n > 10);   // draft.view_all
});

await t('C9 property: 100 random credits and payments (VAT 7.5%) against 5 invoices match an independent BigInt model; balance never negative', async () => {
  let seed = 20261127;
  const rnd = () => { seed = (seed + 0x6D2B79F5) | 0; let x = Math.imul(seed ^ (seed >>> 15), 1 | seed); x = (x + Math.imul(x ^ (x >>> 7), 61 | x)) ^ x; return ((x ^ (x >>> 14)) >>> 0) / 4294967296; };
  const k = await cust('Random Credit Ltd');
  const invs = [];
  for (const unit of [100000, 1234567, 9999999, 50000000, 123456789]) {
    const id = await mkInvoice(k, '1000', String(unit), { vat_enabled: true });
    const total = BigInt(unit) + halfUp(BigInt(unit) * 750n, 10000n);
    assert.equal((await status(id)).total, String(total));
    invs.push({ id, total, credited: 0n, settled: 0n });
  }
  let accepted = 0; let rejected = 0; let paidN = 0;
  for (let n = 0; n < 100; n++) {
    const v = invs[Math.floor(rnd() * invs.length)];
    if (rnd() < 0.25) {                                                                              // a payment of up to half the balance
      const bal = v.total - v.credited - v.settled;
      if (bal < 2n) continue;
      const amt = 1n + BigInt(Math.floor(rnd() * Number(bal / 2n)));
      await pay(k, v.id, amt, `NIP-P9-${n}`); v.settled += amt; paidN++;
      continue;
    }
    const rows = Array.from({ length: 1 + Math.floor(rnd() * 3) }, () => [`Item ${n}`, 1 + Math.floor(rnd() * 5000), Math.floor(rnd() * 40000)]);
    const lineTotals = rows.map(([, qty, unit]) => halfUp(BigInt(qty) * BigInt(unit), 1000n));
    const base = lineTotals.reduce((a, b) => a + b, 0n);
    const total = base + halfUp(base * 750n, 10000n);
    const bal = v.total - v.credited - v.settled;
    const attempt = () => credit(owner, v.id, lines(...rows), 'Random credit');
    if (base === 0n) { await assert.rejects(attempt, /TOTAL_NOT_ABOVE_ZERO/); rejected++; }
    else if (total > v.total - v.credited) { await assert.rejects(attempt, /CREDIT_EXCEEDS_INVOICE/); rejected++; }
    else if (total > bal) { await assert.rejects(attempt, /CREDIT_BELOW_PAYMENTS/); rejected++; }
    else { const r = await attempt(); notes++; accepted++; v.credited += total; assert.equal(r.total, String(total)); assert.equal(r.balance_after, String(v.total - v.credited - v.settled)); }
    if (n % 25 === 24) for (const w of invs) assert.equal((await status(w.id)).balance, String(w.total - w.credited - w.settled));
  }
  for (const w of invs) {
    const s = await status(w.id);
    assert.equal(s.balance, String(w.total - w.credited - w.settled));
    assert.equal(s.credited, String(w.credited));
    assert.ok(BigInt(s.balance) >= 0n);
  }
  assert.ok(accepted > 15 && rejected > 3 && paidN > 3, `accepted ${accepted}, rejected ${rejected}, payments ${paidN}`);
  assert.equal(await noteCounter(), notes);
});

console.log(`\n${passed} credit-note test groups passed`);
assert.equal(passed, 9);
await db.close();
